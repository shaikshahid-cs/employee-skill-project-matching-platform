# ==============================================================================
# EMPLOYEE MATCHING PLATFORM - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.production for deployment build configuration.
# DO NOT commit real secrets or production credentials to source control.

# Base API URL used by Axios client for Spring Boot backend communication
# In Development: Defaults to /api (proxied via Vite to http://localhost:8080)
# In Production: Supply custom API domain or relative proxy path (e.g. /api)
VITE_API_BASE_URL=/api
